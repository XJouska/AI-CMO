<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  {% if seo.keywords %}<meta name="keywords" content="{{ seo.keywords | join(', ') }}">{% endif %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta property="og:type" content="website">
  {% if not preview %}<link rel="stylesheet" href="{{ root }}assets/site.css">{% else %}<style>{{ inline_css }}</style>{% endif %}
  <script type="application/ld+json">{{ json_ld }}</script>
</head>
<body class="tpl-{{ template }}">
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="{{ root }}index.html">{{ content.company_name }}</a>
      <nav class="site-nav" aria-label="Main">
        <a href="{{ root }}index.html#products">Products</a>
        <a href="{{ root }}index.html#about">About</a>
        <a href="{{ root }}index.html#factory">Factory</a>
        <a class="nav-cta" href="{{ root }}index.html#contact">{{ content.hero.cta }}</a>
      </nav>
    </div>
  </header>
  <main>
    {% block main %}{% endblock %}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {{ year }} {{ content.company_name }}</p>
      {% if content.contact.email %}<p><a href="mailto:{{ content.contact.email }}">{{ content.contact.email }}</a></p>{% endif %}
    </div>
  </footer>
</body>
</html>
