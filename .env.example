# AI-CMO 环境变量示例。复制为 .env 后填写真实值；.env 不入库。
# 标注「必填」的变量缺失时 api / worker 启动失败。

# ── 运行环境 ─────────────────────────────────────────────
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:5173
# JSON 数组；同源部署（Nginx 反代 /api/）时留空即可
CORS_ORIGINS=[]

# ── 数据库（必填）────────────────────────────────────────
POSTGRES_USER=aicmo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aicmo
# 本地开发直连；docker compose 中由 compose 根据上面三项自动拼接
DATABASE_URL=postgresql+psycopg://aicmo:change-me@127.0.0.1:55432/aicmo

# ── 安全（必填）──────────────────────────────────────────
# 至少 32 个字符，用于签名链接等。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 出网白名单（JSON 数组）。默认不允许任何内部域名；开放前需项目负责人确认
SSRF_ALLOW_HOSTS=[]

# ── LLM（OpenAI 兼容接口；未配置时 AI 功能降级并提示）──
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── 浏览器抓取（仅 worker）───────────────────────────────
BROWSER_PROFILE_DIR=/data/browser-profile
BROWSER_HEADLESS=true
BROWSER_PROXY=

# ── 存储与上传 ──────────────────────────────────────────
STORAGE_DIR=/data/storage
MAX_UPLOAD_BYTES=20971520

# ── 账号与限流 ──────────────────────────────────────────
SESSION_TTL_DAYS=7
LOGIN_IP_LIMIT=20
REGISTER_IP_LIMIT_PER_HOUR=10
LOGIN_FAIL_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
INVITE_TTL_HOURS=72

# 测试模式：外部服务全部使用假实现。仅用于本地与端到端测试，生产环境开启会启动失败
TEST_MODE=false

# ── 部署（docker compose）───────────────────────────────
# web 容器对宿主机暴露的地址；默认只监听本机，由宿主 Nginx 反代
WEB_BIND=127.0.0.1:9020

# ── 客户官网托管 ────────────────────────────────────────
# 平台子域名的根域名（需泛域名解析与证书），例如 sites.aicmo.site
SITES_BASE_DOMAIN=sites.localhost
SITES_SCHEME=https
SITES_BIND=127.0.0.1:9021
# Cloudflare Turnstile（可选；未配置时询盘只依赖限流与蜜罐）
TURNSTILE_SECRET=
PAGESPEED_API_KEY=

# ── 商机情报 ────────────────────────────────────────────
# 搜索 API：bing / serpapi / none（none 时只使用 RSS 招标源）
SEARCH_API_PROVIDER=none
SEARCH_API_KEY=
# 额外 RSS 数据源（JSON 数组），例如 [{"key":"ungm","url":"https://...","label":"UNGM"}]
RSS_SOURCES=[]
# 单企业单次运行的成本上限
LEADS_MAX_QUERIES=12
LEADS_MAX_FETCHES=40
LEADS_MAX_LLM_CALLS=30
# 自动通过复核的分数线（留空 = 全部人工复核，试点期建议留空）
LEADS_AUTO_APPROVE_SCORE=
